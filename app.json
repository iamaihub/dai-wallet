{
  "expo": {
    "name": "DAI Wallet",
    "slug": "poh-wallet",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dai.wallet",
      "buildNumber": "13"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.dai.wallet",
      "versionCode": 13,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "@qvac/sdk/expo-plugin",
        {
          "installMissingPrebuilds": true
        }
      ],
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "DAI Miner Wallet - Real crypto wallet for the Decentralized Artificial Intelligence network",
    "githubUrl": "https://github.com/iamaihub/dai-miner",
    "extra": {
      "eas": {
        "projectId": "2755d9de-0219-47c3-b393-4bade5b8515f"
      }
    }
  }
}
